/* components/white-card/white-card.wxss */
.white-card-container {
  background-color: #ffffff;
  border-radius: var(--radius-md, 16px);
  border: 1rpx solid var(--border-color, #e9e9e9);
  box-shadow: var(--shadow-card, 0 8rpx 28rpx rgba(48, 38, 28, 0.06));
  box-sizing: border-box;
  overflow: hidden;
}

/* 卡片头部：强制flex布局，标题占满剩余空间，右侧内容靠右 */
.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 104rpx;
  padding: 22rpx 28rpx;
  border-bottom: 1rpx solid var(--border-color, #e9e9e9);
  width: 100%;
  box-sizing: border-box;
}

.header-left {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.header-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-main, #333333);
}

/* 右侧插槽容器：强制显示，避免内容隐藏 */
.header-right {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  min-width: 40rpx; /* 给加号按钮预留最小宽度 */
}

/* 卡片主体（默认内边距，可通过自定义类覆盖） */
.card-body {
  padding: 26rpx 28rpx;
}

/* 卡片底部 */
.card-footer {
  padding: 22rpx 28rpx;
  border-top: 1rpx solid var(--border-color, #e9e9e9);
}

.footer-text {
  font-size: 28rpx;
  color: var(--text-secondary, #666666);
}