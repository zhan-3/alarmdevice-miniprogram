/* app.wxss 全局样式 - 简化兼容版 */
/* 橙色系主色调（直接定义，避免小程序兼容问题） */
page {
  --orange-primary: #F05A28;
  --orange-highlight: #F4774F;
  --orange-action: #C94F00;
  --orange-light: #FFF1EB;
  --orange-border: #E3A48D;
  --orange-dark: #963B16;
  --text-main: #17212B;
  --text-secondary: #59636F;
  --bg-main: #F5F6F7;
  --bg-wash: linear-gradient(180deg, #FFF4EF 0%, #F8F4F1 180px, #F5F6F7 380px);
  --surface: #FFFFFF;
  --border-color: #E1E5E9;
  --radius-sm: 10px;
  --radius-md: 14px;
  --radius-lg: 18px;
  --shadow-card: none;

  background-color: var(--bg-main);
  font-size: 28rpx;
  color: var(--text-main);
  line-height: 1.6;
  --status-alarm-bg: #FFF0EF;
  --status-alarm-color: #B42318;
  --status-normal-bg: #EDF8F0;
  --status-normal-color: #237A3B;
  --status-offline-bg: #EEF0F2;
  --status-offline-color: #5F6873;
}

/* 全局重置button默认样式 */
button {
  margin: 0;
  padding: 0;
  border: none;
}
button::after {
  border: none;
}

/* ===== 加载态（通用） ===== */
.loading-screen {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
}

.loading-spinner {
  width: 40px;
  height: 40px;
  border: 3px solid #e5e8eb;
  border-top-color: var(--orange-primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 14px;
  color: var(--text-secondary);
  margin-top: 12px;
}

/* ===== 请求失败态（通用） ===== */
.error-state {
  min-height: 45vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24px;
  box-sizing: border-box;
}

.retry-btn {
  margin-top: 18px;
  padding: 0 24px;
  min-height: 44px;
  line-height: 44px;
  border-radius: 12px;
  background: var(--orange-action);
  color: #fff;
  font-size: 14px;
}

.btn-disabled {
  opacity: 0.55;
  pointer-events: none;
}

/* ===== 弹窗基础样式（通用） ===== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
  z-index: 998;
}

.modal-input {
  width: 100%;
  height: 44px;
  padding: 0 14px;
  border: 1px solid #eee;
  border-radius: var(--radius-sm);
  font-size: 14px;
  box-sizing: border-box;
}

.modal-btn {
  flex: 1;
  height: 44px;
  line-height: 44px;
  border-radius: 12px;
  font-size: 15px;
  text-align: center;
}

.modal-btn.cancel {
  background: #fff;
  color: #666;
  border: 1px solid #eee;
}

.modal-btn.confirm {
  background: var(--orange-action);
  color: #fff;
}
