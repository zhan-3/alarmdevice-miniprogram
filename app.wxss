/* app.wxss 全局样式 - 简化兼容版 */
/* 橙色系主色调（直接定义，避免小程序兼容问题） */
page {
  --orange-primary: #FF7A00;    /* 主橙色（按钮/导航栏） */
  --orange-light: #FFE8D8;      /* 浅橙色（背景/高亮） */
  --orange-dark: #E86A00;       /* 深橙色（点击态/边框） */
  --text-main: #333333;         /* 主文字色 */
  --text-secondary: #666666;    /* 次要文字色 */
  --bg-main: #FFFFFF;           /* 页面主背景 */
  --border-color: #E9E9E9;      /* 通用边框色 */
  --radius-sm: 10px;
  --radius-md: 16px;
  --radius-lg: 20px;
  --shadow-card: 0 8rpx 28rpx rgba(48, 38, 28, 0.06);
  
  background-color: var(--bg-main);
  font-size: 28rpx;
  color: var(--text-main);
  line-height: 1.6;
  /* 状态标签配色 */
  --status-alarm-bg: #fff1f0;
  --status-alarm-color: #f53f3f;
  --status-normal-bg: #f6ffed;
  --status-normal-color: #52c41a;
  --status-offline-bg: #f5f5f5;
  --status-offline-color: #999;
}

/* 全局重置button默认样式 */
button {
  margin: 0;
  padding: 0;
  border: none;
}
button::after {
  border: none;
}

/* ===== 加载态（通用） ===== */
.loading-screen {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
}

.loading-spinner {
  width: 40px;
  height: 40px;
  border: 3px solid #f0f0f0;
  border-top-color: #FF7A00;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 14px;
  color: #999;
  margin-top: 12px;
}

/* ===== 请求失败态（通用） ===== */
.error-state {
  min-height: 45vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24px;
  box-sizing: border-box;
}

.retry-btn {
  margin-top: 18px;
  padding: 0 24px;
  height: 38px;
  line-height: 38px;
  border-radius: 22px;
  background: #FF7A00;
  color: #fff;
  font-size: 14px;
}

.btn-disabled {
  opacity: 0.55;
  pointer-events: none;
}

/* ===== 弹窗基础样式（通用） ===== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
  z-index: 998;
}

.modal-input {
  width: 100%;
  height: 44px;
  padding: 0 14px;
  border: 1px solid #eee;
  border-radius: var(--radius-sm);
  font-size: 14px;
  box-sizing: border-box;
}

.modal-btn {
  flex: 1;
  height: 44px;
  line-height: 44px;
  border-radius: 12px;
  font-size: 15px;
  text-align: center;
}

.modal-btn.cancel {
  background: #fff;
  color: #666;
  border: 1px solid #eee;
}

.modal-btn.confirm {
  background: #FF7A00;
  color: #fff;
}