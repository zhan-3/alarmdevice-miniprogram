<view class="setting-container">
  <scroll-view class="setting-scroll" scroll-y>
    <!-- 用户资料卡片（仅主页进入时展示） -->
    <white-card wx:if="{{!isDeviceSetting}}" title="个人资料" titleIcon="user-round" customClass="setting-module-card">
      <view class="profile-card">
        <view class="profile-avatar-row">
          <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
            <image class="profile-avatar" src="{{userInfo.avatarUrl || '/images/avatar.png'}}" mode="aspectFill" />
          </button>
          <view class="profile-info">
            <input class="profile-nickname" type="nickname" placeholder="点击填写昵称" value="{{userInfo.nickName}}" bindinput="onNicknameInput" maxlength="20" />
            <view class="profile-phone">
              <text wx:if="{{userInfo.phone}}">{{userInfo.phone}}</text>
              <text wx:else class="phone-unbind">未绑定手机号</text>
            </view>
          </view>
        </view>
      </view>
    </white-card>

    <view wx:if="{{isDeviceSetting && deviceLoading}}" class="loading-screen">
      <text class="loading-text">加载设备信息...</text>
    </view>
    <view wx:elif="{{isDeviceSetting && deviceLoadError}}" class="error-state">
      <text class="empty-text">设备信息加载失败</text>
      <text class="empty-hint">请检查网络连接或设备权限</text>
      <button class="retry-btn" bindtap="retryLoadDevice">重新加载</button>
    </view>

    <block wx:if="{{isDeviceSetting && device && !deviceLoading && !deviceLoadError}}">
      <white-card title="设备位置设置" titleIcon="map-pin" customClass="setting-module-card">
        <view class="location-card">
          <view class="location-map">
            <map
              wx:if="{{device.latitude && device.longitude}}"
              class="preview-map"
              latitude="{{device.latitude}}"
              longitude="{{device.longitude}}"
              scale="15"
              markers="{{markers}}"
            ></map>
            <view wx:else class="map-placeholder">
              <text>暂无位置信息</text>
            </view>
          </view>
          <view class="location-info">
            <view class="location-name">{{device.name}}</view>
            <view class="location-address">
              <app-icon name="map-pin" size="14" muted="{{true}}" />
              <text class="address-text">{{device.address || '请选择设备安装位置'}}</text>
            </view>
          </view>
          <view class="location-actions">
            <button class="location-btn" bindtap="chooseLocation">
              <app-icon name="map-pin" size="16" />
              <text class="btn-text">选择位置</text>
            </button>
          </view>
        </view>
      </white-card>

      <white-card title="设备信息" titleIcon="clipboard-list" customClass="setting-module-card">
        <view class="device-info-grid">
          <view class="info-item name-item" bindtap="editDeviceName">
            <text class="info-label">名称</text>
            <view class="info-value-row">
              <text class="info-value">{{device.name}}</text>
              <app-icon name="pencil" size="15" label="编辑设备名称" />
            </view>
          </view>
          <view class="info-item">
            <text class="info-label">序列号</text>
            <text class="info-value sn-value">{{device.sn}}</text>
          </view>
          <view class="info-item">
            <text class="info-label">状态</text>
            <text class="info-value status-badge {{device.status}}">{{device.statusText}}</text>
          </view>
        </view>
      </white-card>
    </block>

    <block wx:if="{{!isDeviceSetting}}">
    <white-card title="录音偏好" titleIcon="mic" customClass="setting-module-card">
      <view class="setting-item">
        <view class="item-label">报警自动录音</view>
        <switch class="item-switch" checked="{{autoRecord}}" bindchange="switchAutoRecord" />
      </view>
      <view class="setting-item">
        <view class="item-label">录音质量</view>
        <picker class="item-picker" mode="selector" range="{{recordQualityList}}" value="{{qualityIndex}}" bindchange="changeRecordQuality">
          <view>{{recordQualityList[qualityIndex]}}</view>
        </picker>
      </view>
      <view class="setting-item">
        <view class="item-label">录音自动保存</view>
        <picker class="item-picker" mode="selector" range="{{saveDayList}}" value="{{dayIndex}}" bindchange="changeSaveDay">
          <view>{{saveDayList[dayIndex]}}</view>
        </picker>
      </view>
    </white-card>

    <white-card title="提醒偏好" titleIcon="settings-2" customClass="setting-module-card">
      <view class="setting-item">
        <view class="item-label">APP报警推送</view>
        <switch class="item-switch" checked="{{alarmPush}}" bindchange="switchAlarmPush" />
      </view>
      <view class="setting-item">
        <view class="item-label">APP报警铃声</view>
        <switch class="item-switch" checked="{{alarmSound}}" bindchange="switchAlarmSound" />
      </view>
      <view class="setting-item">
        <view class="item-label">设备断连提醒</view>
        <switch class="item-switch" checked="{{disconnectWarn}}" bindchange="switchDisconnectWarn" />
      </view>
    </white-card>
    </block>

    <view wx:if="{{!isDeviceSetting}}" class="account-actions">
      <button class="logout-btn {{isLoggingOut ? 'btn-disabled' : ''}}" bindtap="logout">
        {{isLoggingOut ? '正在退出…' : '退出登录'}}
      </button>
      <text class="logout-hint">退出后不会删除服务器上的报警记录</text>
    </view>
  </scroll-view>
</view>

<view class="modal-mask" wx:if="{{showEditNameModal}}" bindtap="closeEditNameModal"></view>
<view class="modal-container" wx:if="{{showEditNameModal}}">
  <view class="modal-title">修改设备名称</view>
  <view class="modal-form">
    <input 
      class="modal-input" 
      type="text" 
      placeholder="请输入设备名称" 
      bindinput="onNameInput"
      value="{{tempName}}"
      maxlength="20"
    />
  </view>
  <view class="modal-btn-group">
    <view class="modal-btn cancel" bindtap="closeEditNameModal" hover-class="btn-press">取消</view>
    <view class="modal-btn confirm" bindtap="saveName" hover-class="btn-press">保存</view>
  </view>
</view>
