<view class="container">
  <view class="head-card">
    <view class="head-icon">
      <app-icon name="bell-white" size="28" label="报警记录" />
    </view>
    <view class="head-content">
      <text class="head-title">报警记录</text>
      <text class="head-subtitle">及时确认每一次设备报警</text>
    </view>
    <view class="manage-link" bindtap="goDevices" aria-label="进入设备管理">
      <text>设备管理</text>
      <text class="manage-arrow">›</text>
    </view>
  </view>

  <view class="notice-bar">
    <app-icon name="triangle-alert" size="18" label="说明" />
    <text>这里记录设备曾经发出的报警；“已处理”仅表示人工确认，不代表设备当前状态。</text>
  </view>

  <view wx:if="{{isLogin}}" class="subscription-bar">
    <view class="subscription-copy">
      <text class="subscription-title">微信报警提醒</text>
      <text class="subscription-hint">每次授权可接收一次设备报警通知</text>
    </view>
    <button
      class="subscription-button {{subscribing ? 'btn-disabled' : ''}}"
      bindtap="subscribeAlarmNotifications"
      disabled="{{subscribing}}"
    >{{subscribing ? '请求中…' : '订阅提醒'}}</button>
  </view>

  <view wx:if="{{!isLogin}}" class="state-panel">
    <view class="state-icon"><app-icon name="inbox" size="44" muted="{{true}}" label="暂无报警记录" /></view>
    <text class="state-title">登录后查看报警记录</text>
    <text class="state-hint">我们会按时间整理与你相关的设备报警</text>
    <button class="primary-button" bindtap="goLogin">去登录</button>
  </view>

  <block wx:else>
    <view class="tabs" aria-label="报警状态筛选">
      <view class="tab {{activeStatus === 'pending' ? 'active' : ''}}" data-status="pending" bindtap="selectStatus">待处理</view>
      <view class="tab {{activeStatus === 'handled' ? 'active' : ''}}" data-status="handled" bindtap="selectStatus">已处理</view>
      <view class="tab {{activeStatus === 'all' ? 'active' : ''}}" data-status="all" bindtap="selectStatus">全部</view>
    </view>

    <view wx:if="{{loading && alarms.length === 0}}" class="loading-screen compact-loading">
      <view class="loading-spinner"></view>
      <text class="loading-text">正在整理报警记录...</text>
    </view>

    <view wx:elif="{{loadError && alarms.length === 0}}" class="state-panel">
      <view class="state-icon"><app-icon name="circle-minus-danger" size="42" label="加载失败" /></view>
      <text class="state-title">暂时无法获取报警记录</text>
      <text class="state-hint">请检查网络连接后再试一次</text>
      <button class="primary-button" bindtap="retryLoad">重新加载</button>
    </view>

    <view wx:elif="{{!loading && alarms.length === 0}}" class="state-panel">
      <view class="state-icon"><app-icon name="inbox" size="44" muted="{{true}}" label="暂无记录" /></view>
      <text class="state-title">{{activeStatus === 'pending' ? '没有待处理报警' : activeStatus === 'handled' ? '还没有已处理记录' : '暂时没有报警记录'}}</text>
      <text class="state-hint">{{activeStatus === 'pending' ? '当前没有需要你确认的报警' : '设备发出报警后会显示在这里'}}</text>
    </view>

    <view wx:else class="alarm-sheet">
      <view wx:for="{{alarms}}" wx:key="alarmId" class="alarm-item">
        <view class="status-mark {{item.status}}"></view>
        <view class="alarm-content">
          <view class="alarm-topline">
            <text class="device-name">设备 {{item.deviceSn || '未知'}}</text>
            <text class="alarm-status {{item.status}}">{{item.status === 'handled' ? '已处理' : '待处理'}}</text>
          </view>

          <text class="alarm-time">{{item.displayTime}}</text>

          <view class="alarm-details">
            <view class="detail-item">
              <app-icon name="map-pin" size="15" muted="{{true}}" />
              <text>{{item.gpsLat !== null && item.gpsLng !== null ? '已记录报警位置' : '未提供报警位置'}}</text>
            </view>
            <view wx:if="{{item.fileId}}" class="detail-item">
              <app-icon name="audio-lines" size="15" muted="{{true}}" />
              <text>已保存报警录音</text>
            </view>
          </view>

          <view class="alarm-actions">
            <view
              wx:if="{{item.gpsLat !== null && item.gpsLng !== null}}"
              class="location-action"
              data-lat="{{item.gpsLat}}"
              data-lng="{{item.gpsLng}}"
              data-sn="{{item.deviceSn}}"
              bindtap="openAlarmLocation"
            >查看位置</view>
            <view
              wx:if="{{item.status === 'pending'}}"
              class="handle-button {{handlingId === item.alarmId ? 'btn-disabled' : ''}}"
              data-id="{{item.alarmId}}"
              catchtap="handleAlarm"
              hover-class="action-pressed"
              aria-role="button"
              aria-label="确认该报警已处理"
            >{{handlingId === item.alarmId ? '确认中…' : '确认已处理'}}</view>
            <text wx:elif="{{item.displayHandledAt}}" class="handled-time">{{item.displayHandledAt}} 已确认</text>
          </view>
        </view>
      </view>

      <view wx:if="{{loading}}" class="list-footer">正在加载...</view>
      <view wx:elif="{{hasMore}}" class="list-footer more-button" bindtap="loadMore">加载更多记录</view>
      <view wx:else class="list-footer end-text">没有更多记录了</view>
    </view>
  </block>
</view>
