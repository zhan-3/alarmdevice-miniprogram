<view class="container">
  <view wx:if="{{!isLogin}}" class="state-panel">
    <view class="state-icon"><app-icon name="inbox" size="44" muted="{{true}}" label="暂无报警记录" /></view>
    <text class="state-title">登录后查看报警记录</text>
    <text class="state-hint">我们会按时间整理与你相关的设备报警</text>
    <button class="primary-button" bindtap="goLogin">去登录</button>
  </view>

  <block wx:else>
    <view class="alarm-section-heading">
      <view class="alarm-heading-copy">
        <text class="alarm-section-title">待处理报警</text>
        <text class="alarm-section-note">需要你确认的设备报警</text>
      </view>
      <view class="profile-entry" bindtap="goProfile" aria-role="button" aria-label="打开个人设置">
        <image wx:if="{{userInfo.avatarUrl}}" class="profile-avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill" />
        <app-icon wx:else name="user-round" size="21" label="个人设置" />
      </view>
    </view>

    <view class="subscription-bar">
      <view class="subscription-icon">
        <app-icon name="bell" size="20" label="报警通知" />
      </view>
      <view class="subscription-copy">
        <text class="subscription-title">下一次报警通知</text>
        <text class="subscription-hint">每次开启可接收 1 次微信通知</text>
      </view>
      <button
        class="subscription-button {{subscribing || subscriptionAccepted ? 'btn-disabled' : ''}}"
        bindtap="subscribeAlarmNotifications"
        disabled="{{subscribing || subscriptionAccepted}}"
      >{{subscribing ? '开启中…' : subscriptionAccepted ? '已开启 1 次' : '开启下一次'}}</button>
    </view>

    <view wx:if="{{loading && alarms.length === 0}}" class="loading-screen compact-loading">
      <view class="loading-spinner"></view>
      <text class="loading-text">正在整理报警记录...</text>
    </view>

    <view wx:elif="{{loadError && alarms.length === 0}}" class="state-panel">
      <view class="state-icon"><app-icon name="circle-minus-danger" size="42" label="加载失败" /></view>
      <text class="state-title">暂时无法获取报警记录</text>
      <text class="state-hint">请检查网络连接后再试一次</text>
      <button class="primary-button" bindtap="retryLoad">重新加载</button>
    </view>

    <view wx:elif="{{!loading && alarms.length === 0}}" class="state-panel calm-state">
      <view class="state-icon calm-state-icon">
        <app-icon name="circle-check-green" size="34" label="当前无待处理报警" />
      </view>
      <text class="state-title calm-state-title">当前无待处理报警</text>
      <text class="state-hint">新的设备报警会显示在这里</text>
    </view>

    <view wx:else class="alarm-sheet">
      <view wx:for="{{alarms}}" wx:key="alarmId" class="alarm-item {{item.status}}">
        <view class="status-mark {{item.status}}"></view>
        <view class="alarm-content">
          <view class="alarm-topline">
            <view class="device-identity">
              <text class="device-name">{{item.deviceName || (item.deviceSn ? '设备 ' + item.deviceSn : '未知设备')}}</text>
              <text wx:if="{{item.deviceName && item.deviceSn}}" class="device-sn">SN {{item.deviceSn}}</text>
            </view>
            <text class="alarm-status {{item.status}}">{{item.status === 'handled' ? '已处理' : '待处理'}}</text>
          </view>

          <text class="alarm-time">报警时间 · {{item.displayTime}}</text>

          <view class="alarm-details">
            <view class="detail-item">
              <app-icon name="map-pin" size="15" muted="{{true}}" />
              <text>{{item.gpsLat !== null && item.gpsLng !== null ? '已记录报警位置' : '未提供报警位置'}}</text>
            </view>
            <view wx:if="{{item.fileId}}" class="detail-item">
              <app-icon name="audio-lines" size="15" muted="{{true}}" />
              <text>已保存报警录音</text>
            </view>
          </view>

          <view class="alarm-actions">
            <view
              wx:if="{{item.gpsLat !== null && item.gpsLng !== null}}"
              class="location-action"
              data-lat="{{item.gpsLat}}"
              data-lng="{{item.gpsLng}}"
              data-sn="{{item.deviceSn}}"
              bindtap="openAlarmLocation"
              aria-role="button"
              aria-label="查看该报警的位置"
            >查看位置</view>
            <view
              wx:if="{{item.status === 'pending' && item.canHandle}}"
              class="handle-button {{handlingId === item.alarmId ? 'btn-disabled' : ''}}"
              data-id="{{item.alarmId}}"
              catchtap="handleAlarm"
              hover-class="action-pressed"
              aria-role="button"
              aria-label="将该报警标记为已处理"
            >{{handlingId === item.alarmId ? '处理中…' : '标记已处理'}}</view>
            <text wx:elif="{{item.status === 'pending'}}" class="action-unavailable">记录不可处理</text>
            <text wx:elif="{{item.displayHandledAt}}" class="handled-time">{{item.displayHandledAt}} 已确认</text>
          </view>
        </view>
      </view>

      <view wx:if="{{loading}}" class="list-footer">正在加载...</view>
      <view wx:elif="{{hasMore}}" class="list-footer more-button" bindtap="loadMore" aria-role="button">加载更多记录</view>
      <view wx:else class="list-footer end-text">没有更多记录了</view>
    </view>

    <view class="notice-bar">
      <app-icon name="triangle-alert" size="18" label="处理状态说明" />
      <text>“已处理”仅表示人工确认，不代表设备当前已经恢复正常。</text>
    </view>

    <view wx:if="{{!handledExpanded}}" class="handled-disclosure" bindtap="showHandledAlarms" hover-class="action-pressed" aria-role="button" aria-label="查看已处理的报警记录">
      <view>
        <text class="handled-disclosure-title">查看已处理记录</text>
        <text class="handled-disclosure-hint">需要时再加载历史记录</text>
      </view>
      <text class="handled-disclosure-arrow">›</text>
    </view>

    <block wx:else>
      <view class="alarm-section-heading handled-heading">
        <text class="alarm-section-title">已处理</text>
        <text class="alarm-section-note">最近确认的报警记录</text>
      </view>

      <view wx:if="{{handledLoading && handledAlarms.length === 0}}" class="loading-screen compact-loading">
        <view class="loading-spinner"></view>
        <text class="loading-text">正在加载已处理记录...</text>
      </view>

      <view wx:elif="{{handledLoadError && handledAlarms.length === 0}}" class="state-panel compact-state-panel">
        <text class="state-title">已处理记录加载失败</text>
        <button class="primary-button" bindtap="retryHandledAlarms">重新加载</button>
      </view>

      <view wx:elif="{{!handledLoading && handledAlarms.length === 0}}" class="state-panel compact-state-panel">
        <text class="state-title">还没有已处理记录</text>
        <text class="state-hint">确认过的报警会显示在这里</text>
      </view>

      <view wx:else class="alarm-sheet">
        <view wx:for="{{handledAlarms}}" wx:key="alarmId" class="alarm-item handled">
          <view class="status-mark handled"></view>
          <view class="alarm-content">
            <view class="alarm-topline">
              <view class="device-identity">
                <text class="device-name">{{item.deviceName || (item.deviceSn ? '设备 ' + item.deviceSn : '未知设备')}}</text>
                <text wx:if="{{item.deviceName && item.deviceSn}}" class="device-sn">SN {{item.deviceSn}}</text>
              </view>
              <text class="alarm-status handled">已处理</text>
            </view>
            <text class="alarm-time">报警时间 · {{item.displayTime}}</text>
            <view class="alarm-details">
              <view class="detail-item">
                <app-icon name="map-pin" size="15" muted="{{true}}" />
                <text>{{item.gpsLat !== null && item.gpsLng !== null ? '已记录报警位置' : '未提供报警位置'}}</text>
              </view>
              <view wx:if="{{item.fileId}}" class="detail-item">
                <app-icon name="audio-lines" size="15" muted="{{true}}" />
                <text>已保存报警录音</text>
              </view>
            </view>
            <view class="alarm-actions">
              <view
                wx:if="{{item.gpsLat !== null && item.gpsLng !== null}}"
                class="location-action"
                data-lat="{{item.gpsLat}}"
                data-lng="{{item.gpsLng}}"
                data-sn="{{item.deviceSn}}"
                bindtap="openAlarmLocation"
                aria-role="button"
                aria-label="查看该报警的位置"
              >查看位置</view>
              <text wx:if="{{item.displayHandledAt}}" class="handled-time">{{item.displayHandledAt}} 已确认</text>
            </view>
          </view>
        </view>
        <view wx:if="{{handledLoading}}" class="list-footer">正在加载...</view>
        <view wx:elif="{{handledHasMore}}" class="list-footer more-button" bindtap="loadMoreHandled" aria-role="button">加载更多已处理记录</view>
        <view wx:else class="list-footer end-text">没有更多已处理记录了</view>
      </view>
    </block>
  </block>
</view>
