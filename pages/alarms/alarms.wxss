.container {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 20px 15px 30px;
  background: var(--bg-wash);
}

.profile-entry {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 44px;
  width: 44px;
  max-width: 44px;
  height: 44px;
  margin-left: 12px;
  padding: 3px;
  border: 1px solid var(--border-color);
  border-radius: 50%;
  background: var(--surface);
  box-shadow: none;
  box-sizing: border-box;
  overflow: hidden;
}

.profile-avatar {
  display: block;
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: #f1eee9;
}

.subscription-bar {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12px;
  margin-bottom: 16px;
  padding: 14px;
  border: 1rpx solid var(--orange-border);
  border-radius: var(--radius-md);
  background: linear-gradient(120deg, #FFF1EB 0%, #FFF8F5 100%);
  box-shadow: 0 8rpx 22rpx rgba(201, 79, 0, 0.08);
}

.subscription-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 40px;
  height: 40px;
  border-radius: 10px;
  background: #FFFFFF;
  box-shadow: inset 0 0 0 1rpx var(--orange-border);
}

.subscription-copy {
  flex: 1 1 calc(100% - 52px);
  min-width: 0;
}

.subscription-title,
.subscription-hint {
  display: block;
}

.subscription-title {
  color: var(--text-main);
  font-size: 14px;
  font-weight: 600;
}

.subscription-hint {
  margin-top: 3px;
  color: var(--text-secondary);
  font-size: 12px;
  line-height: 1.45;
}

.subscription-button {
  flex: 0 0 100%;
  min-width: 0;
  height: 44px;
  margin: 0;
  padding: 0 14px;
  box-sizing: border-box;
  border: 1px solid var(--orange-border);
  border-radius: 10px;
  background: #FFFFFF;
  color: var(--orange-dark);
  font-size: 13px;
  font-weight: 600;
  line-height: 42px;
}

.subscription-button::after {
  border: 0;
}

.alarm-section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin: 0 2px 10px;
}

.alarm-heading-copy {
  min-width: 0;
}

.alarm-section-title,
.alarm-section-note {
  display: block;
}

.alarm-section-title {
  color: var(--text-main);
  font-size: 18px;
  font-weight: 600;
}

.alarm-section-note {
  margin-top: 2px;
  color: #737373;
  font-size: 12px;
}

.handled-disclosure {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14px;
  padding: 15px 17px;
  border: 1rpx solid var(--border-color);
  border-radius: var(--radius-md);
  background: #fff;
  box-shadow: var(--shadow-card);
}

.handled-disclosure-title,
.handled-disclosure-hint {
  display: block;
}

.handled-disclosure-title {
  color: var(--text-main);
  font-size: 14px;
  font-weight: 600;
}

.handled-disclosure-hint {
  margin-top: 2px;
  color: #737373;
  font-size: 11px;
}

.handled-disclosure-arrow {
  flex: 0 0 auto;
  width: 18px;
  height: 18px;
}

.alarm-sheet {
  box-sizing: border-box;
}

.state-panel {
  overflow: hidden;
  box-sizing: border-box;
  border: 1rpx solid var(--border-color);
  border-radius: var(--radius-lg);
  background: #fff;
  box-shadow: var(--shadow-card);
}

.alarm-item {
  display: flex;
  align-items: stretch;
  margin-bottom: 12px;
  padding: 18px 17px;
  border: 1rpx solid var(--border-color);
  border-radius: var(--radius-md);
  background: #FFFFFF;
  box-shadow: var(--shadow-card);
}

.alarm-item.pending {
  border-color: #E7B6B2;
  background: linear-gradient(105deg, #FFF2EF 0%, #FFFFFF 32%);
}

.alarm-item.handled {
  border-color: #CFE2D4;
}

.status-mark {
  flex-shrink: 0;
  width: 10px;
  height: 10px;
  margin: 6px 12px 0 0;
  border-radius: 50%;
  background: #c7c7c7;
}

.status-mark.pending {
  background: var(--status-alarm-color);
}

.status-mark.handled {
  background: var(--status-normal-color);
}

.alarm-content {
  flex: 1;
  min-width: 0;
}

.alarm-topline,
.alarm-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.device-identity {
  flex: 1;
  min-width: 0;
}

.device-name,
.device-sn {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.device-name {
  color: var(--text-main);
  font-size: 15px;
  font-weight: 600;
}

.device-sn {
  margin-top: 2px;
  color: var(--text-secondary);
  font-size: 12px;
}

.alarm-status {
  flex-shrink: 0;
  padding: 3px 8px;
  border-radius: 7px;
  font-size: 12px;
}

.alarm-status.pending {
  background: var(--status-alarm-bg);
  color: var(--status-alarm-color);
}

.alarm-status.handled {
  background: var(--status-normal-bg);
  color: var(--status-normal-color);
}

.alarm-time {
  display: block;
  margin-top: 6px;
  color: var(--text-secondary);
  font-size: 13px;
}

.alarm-details {
  display: flex;
  flex-wrap: wrap;
  gap: 6px 16px;
  margin-top: 11px;
  color: var(--text-secondary);
  font-size: 13px;
}

.detail-item {
  display: flex;
  align-items: center;
  gap: 4px;
}

.alarm-actions {
  min-height: 34px;
  margin-top: 14px;
  padding-top: 12px;
  border-top: 1rpx solid #f2f2f2;
}

.location-action {
  display: flex;
  align-items: center;
  min-height: 44px;
  color: var(--orange-dark);
  font-size: 13px;
  font-weight: 600;
}

.handle-button,
.primary-button {
  min-height: 44px;
  padding: 0 18px;
  border-radius: 10px;
  background: var(--orange-action);
  color: #fff;
  font-size: 13px;
  line-height: 40px;
}

.handle-button {
  flex-shrink: 0;
  margin-left: auto;
  text-align: center;
}

.action-pressed {
  opacity: 0.75;
}

.handled-time,
.action-unavailable {
  margin-left: auto;
  color: #777;
  font-size: 12px;
}

.action-unavailable {
  color: #999;
}

.state-panel {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 42px 24px;
  text-align: center;
}

.calm-state {
  min-height: 210px;
  justify-content: center;
  border-color: #CFE2D4;
  background: linear-gradient(145deg, #F2F8F3 0%, #FFFFFF 100%);
  box-shadow: 0 8rpx 22rpx rgba(35, 122, 59, 0.07);
}

.state-icon {
  margin-bottom: 12px;
}

.calm-state-icon {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68px;
  height: 68px;
  margin-bottom: 16px;
  border: 1px solid #d5e9ca;
  border-radius: 22px;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 12rpx 24rpx rgba(56, 158, 13, 0.1);
}

.state-title,
.state-hint {
  display: block;
}

.state-title {
  color: #444;
  font-size: 15px;
  font-weight: 500;
}

.calm-state-title {
  position: relative;
  z-index: 1;
  color: #2f5620;
  font-size: 17px;
  font-weight: 600;
}

.state-hint {
  margin-top: 5px;
  color: var(--text-secondary);
  font-size: 13px;
}

.calm-state .state-hint {
  position: relative;
  z-index: 1;
  color: #5e7354;
}

.state-panel .primary-button {
  margin-top: 18px;
}

.compact-loading {
  min-height: 240px;
  border: 1rpx solid var(--border-color);
  border-radius: var(--radius-lg);
  background: #fff;
}

.list-footer {
  padding: 7px 14px 12px;
  color: #888;
  text-align: center;
  font-size: 12px;
}

.more-button {
  color: var(--orange-dark);
  font-weight: 500;
}

.end-text {
  color: #aaa;
}
