.container {
  min-height: 100vh;
  padding: 34px 20px 24px;
  box-sizing: border-box;
  background: var(--bg-wash);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.header-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64px;
  height: 64px;
  margin-bottom: 18px;
  border: 1px solid var(--orange-border);
  border-radius: 14px;
  background: var(--orange-light);
}

.header-title {
  margin-bottom: 6px;
  color: var(--text-main);
  font-size: 23px;
  font-weight: 700;
  letter-spacing: -0.3px;
}

.header-desc {
  margin-bottom: 30px;
  color: var(--text-secondary);
  font-size: 14px;
}

.bind-methods {
  display: flex;
  flex-direction: column;
  gap: 12px;
  width: 100%;
  margin-bottom: 30px;
}

.method-card {
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 92px;
  padding: 18px;
  box-sizing: border-box;
  border: 1px solid var(--border-color);
  border-radius: var(--radius-md);
  background: var(--surface);
  box-shadow: var(--shadow-card);
}

.method-card:active {
  transform: scale(0.985);
  opacity: 0.9;
}

.method-card.scan {
  min-height: 108px;
  border-color: var(--orange-primary);
  background: linear-gradient(135deg, var(--orange-primary) 0%, var(--orange-highlight) 100%);
  color: var(--text-main);
  box-shadow: 0 10rpx 24rpx rgba(201, 79, 0, 0.2);
}

.method-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 52px;
  width: 52px;
  height: 52px;
  margin-right: 15px;
  border-radius: 12px;
  background: var(--orange-light);
}

.method-card.scan .method-icon {
  background: rgba(255, 255, 255, 0.3);
  box-shadow: inset 0 0 0 1rpx rgba(31, 41, 51, 0.16);
}

.method-copy {
  flex: 1;
  min-width: 0;
  text-align: left;
}

.method-title {
  margin-bottom: 3px;
  color: var(--text-main);
  font-size: 16px;
  font-weight: 700;
}

.method-desc {
  color: var(--text-secondary);
  font-size: 13px;
  line-height: 1.5;
}

.method-card.scan .method-title,
.method-card.scan .method-desc {
  color: var(--text-main);
}

.method-card.scan .method-desc {
  opacity: 0.82;
}

.tips-section {
  width: 100%;
  padding: 20px 2px 0;
  box-sizing: border-box;
  border-top: 1px solid var(--border-color);
}

.tips-title {
  margin-bottom: 10px;
  color: var(--text-main);
  font-size: 14px;
  font-weight: 700;
}

.tips-item {
  color: var(--text-secondary);
  font-size: 13px;
  line-height: 1.9;
}

.modal-mask {
  animation: maskFadeIn 0.18s ease-out;
}

.modal-container {
  position: fixed;
  z-index: 999;
  top: 50%;
  left: 50%;
  width: 86%;
  max-width: 340px;
  overflow: hidden;
  border-radius: var(--radius-lg);
  background: var(--surface);
  box-shadow: 0 24rpx 70rpx rgba(31, 41, 51, 0.22);
  transform: translate(-50%, -50%);
  animation: modalPopIn 0.2s ease-out;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 66px;
  padding: 10px 14px 10px 20px;
  box-sizing: border-box;
  border-bottom: 1px solid var(--border-color);
}

.modal-title {
  color: var(--text-main);
  font-size: 17px;
  font-weight: 700;
}

.modal-close {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  color: var(--text-secondary);
}

.modal-body {
  padding: 22px 20px;
}

.modal-input {
  min-height: 48px;
  color: var(--text-main);
  background: #FFFFFF;
}

.modal-input:focus {
  border-color: var(--orange-primary);
  outline: none;
}

.modal-input.input-error {
  border-color: var(--status-alarm-color);
}

.input-error-tip {
  display: block;
  margin-top: 6px;
  color: var(--status-alarm-color);
  font-size: 12px;
}

.modal-footer {
  display: flex;
  gap: 12px;
  padding: 14px 20px 20px;
}

.modal-btn {
  min-height: 44px;
  border-radius: 10px;
}

.modal-btn.confirm:active {
  background: var(--orange-dark);
}

.modal-btn.btn-disabled {
  background: #C5C9CE !important;
}

@keyframes maskFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes modalPopIn {
  from {
    opacity: 0;
    transform: translate(-50%, -48%) scale(0.98);
  }
  to {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }
}
