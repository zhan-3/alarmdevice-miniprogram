<view class="container">
  <view class="header-icon">
    <app-icon name="smartphone" size="40" label="绑定设备" />
  </view>
  <view class="header-title">绑定新设备</view>
  <view class="header-desc">将设备绑定到您的账户</view>

  <view class="bind-methods">
    <view class="method-card scan" bindtap="scanBindDevice" aria-role="button" aria-label="扫描设备二维码绑定">
      <view class="method-icon">
        <app-icon name="scan-line-dark" size="30" label="扫码绑定" />
      </view>
      <view class="method-copy">
        <view class="method-title">扫码绑定</view>
        <view class="method-desc">扫描设备机身上的二维码</view>
      </view>
    </view>

    <view class="method-card manual" bindtap="openManualBind" aria-role="button" aria-label="手动输入设备编号">
      <view class="method-icon">
        <app-icon name="pencil" size="26" label="手动输入" />
      </view>
      <view class="method-copy">
        <view class="method-title">手动输入</view>
        <view class="method-desc">二维码不可用时输入设备编号</view>
      </view>
    </view>
  </view>

  <view class="tips-section">
    <view class="tips-title">绑定说明</view>
    <view class="tips-item">1. 找到设备机身上的二维码或SN码</view>
    <view class="tips-item">2. 点击扫码或手动输入SN码</view>
    <view class="tips-item">3. 绑定成功后即可使用设备功能</view>
  </view>

  <!-- 手动绑定弹窗 -->
  <view class="modal-mask" wx:if="{{showManualBind}}" bindtap="closeManualBind"></view>
  <view class="modal-container" wx:if="{{showManualBind}}" catchtap>
    <!-- 弹窗标题 -->
    <view class="modal-header">
      <view class="modal-title">输入设备SN码</view>
      <view class="modal-close" bindtap="closeManualBind" aria-role="button" aria-label="关闭">
        <app-icon name="x-gray" size="20" />
      </view>
    </view>
    <!-- 输入框 -->
    <view class="modal-body">
      <input
        class="modal-input {{snError ? 'input-error' : ''}}"
        type="text"
        placeholder="请输入设备SN码（字母、数字、-、_，32位以内）"
        bindinput="onInputSN"
        value="{{inputSN}}"
        maxlength="32"
      />
      <text wx:if="{{snError}}" class="input-error-tip">SN码只能包含字母、数字、短横线和下划线</text>
    </view>
    <!-- 按钮组 -->
    <view class="modal-footer">
      <button class="modal-btn cancel" bindtap="closeManualBind">取消</button>
      <button class="modal-btn confirm {{snError ? 'btn-disabled' : ''}}" bindtap="confirmBind" loading="{{isLoading}}" disabled="{{snError}}">确认绑定</button>
    </view>
  </view>
</view>