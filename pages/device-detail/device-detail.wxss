.container {
  padding: 0;
  background: var(--bg-wash);
  min-height: 100vh;
}

.map-section {
  position: relative;
  height: 210px;
  overflow: hidden;
  background: #eef1f4;
}

.device-map {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.map-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  background: #eef1f4;
  color: #5f6973;
  font-size: 13px;
}

.device-overview {
  padding: 16px 15px 14px;
  border-bottom: 1rpx solid var(--border-color);
  border-radius: 0 0 var(--radius-lg) var(--radius-lg);
  background: #fff;
  box-shadow: var(--shadow-card);
}

.device-summary {
  min-width: 0;
}

.device-name-row {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 6px;
}

.device-name-text {
  font-size: 15px;
  font-weight: 600;
  color: #333;
}

.alarm-badge {
  font-size: 11px;
  padding: 2px 8px;
  border-radius: 8px;
}

.alarm-badge.alarm {
  background: var(--status-alarm-bg);
  color: var(--status-alarm-color);
}

.alarm-badge.normal {
  background: var(--status-normal-bg);
  color: var(--status-normal-color);
}

.alarm-badge.offline,
.alarm-badge.unknown {
  background: var(--status-offline-bg);
  color: var(--status-offline-color);
}

.address-row {
  display: flex;
  align-items: center;
  gap: 4px;
}

.address-text {
  flex: 1;
  font-size: 13px;
  color: var(--text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.quick-actions {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10px;
  margin-top: 14px;
}

.quick-action {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  min-width: 0;
  min-height: 46px;
  background: var(--orange-light);
  border-radius: 10px;
}

.quick-action:active {
  background: #FFE0D4;
}

.quick-action .action-img {
  width: 20px;
  height: 20px;
  filter: brightness(0);
}

.quick-action .action-label {
  color: var(--orange-dark);
  font-size: 13px;
  font-weight: 500;
}

.info-card, .contact-card {
  margin: 15px;
  border-radius: 12px;
}

.contact-helper {
  margin-bottom: 10px;
  color: #666;
  font-size: 12px;
  line-height: 1.5;
}

.compact-info {
  display: flex;
  justify-content: space-between;
}

.info-cell {
  flex: 1;
  padding: 8px 4px;
  text-align: center;
}

.info-cell:active {
  background: #fafafa;
}

.cell-label {
  display: block;
  font-size: 12px;
  color: var(--text-secondary);
  margin-bottom: 4px;
}

.cell-value {
  font-size: 13px;
  color: #333;
  display: inline-flex;
  align-items: center;
  gap: 4px;
}

.status-text.alarm {
  color: var(--status-alarm-color);
}

.status-text.normal {
  color: var(--status-normal-color);
}

.status-text.offline {
  color: var(--status-offline-color);
}

.sn-text {
  font-family: monospace;
  font-size: 11px;
}

.edit-icon {
  color: var(--orange-primary);
  font-size: 12px;
}

.add-btn {
  color: var(--orange-primary);
  font-size: 18px;
  font-weight: bold;
  width: 44px;
  height: 44px;
  border-radius: var(--radius-sm);
  background-color: var(--orange-light);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  pointer-events: auto;
}

.contact-item-wrap {
  position: relative;
  overflow: hidden;
}

.contact-item-wrap.swiped {
  overflow: visible;
}

.contact-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px 0;
  border-bottom: 1px solid #eee;
  background: #fff;
  transition: transform 0.15s ease-out;
  position: relative;
  z-index: 1;
}

.contact-item:last-child {
  border-bottom: none;
}

.contact-info {
  flex: 1;
}

.contact-name {
  font-size: 14px;
  color: #333;
}

.contact-phone {
  font-size: 13px;
  color: var(--text-secondary);
  margin-top: 2px;
}

.delete-btn {
  position: absolute;
  right: -60px;
  top: 0;
  bottom: 1px;
  width: 60px;
  background: #f53f3f;
  color: #fff;
  font-size: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 0;
}

.contact-item-wrap.swiped .delete-btn {
  right: 0;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24px 20px;
}

.empty-icon {
  margin-bottom: 10px;
}

.empty-text {
  font-size: 14px;
  color: var(--text-main);
  margin-bottom: 4px;
}

.empty-hint {
  font-size: 13px;
  color: var(--text-secondary);
}

.modal-container {
  position: fixed;
  top: 50%;
  left: 0;
  right: 0;
  margin: 0 auto;
  transform: translateY(-50%);
  width: 85%;
  max-width: 320px;
  background: #fff;
  border-radius: 16px;
  overflow: hidden;
  z-index: 999;
}

.modal-header {
  padding: 16px 20px;
  border-bottom: 1px solid #eee;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.modal-header .modal-title {
  font-size: 17px;
  font-weight: 600;
  color: #333;
}

.modal-close {
  font-size: 20px;
  color: #666;
  width: 44px;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-body {
  padding: 20px;
}

.form-item {
  margin-bottom: 15px;
}

.form-item:last-child {
  margin-bottom: 0;
}

.contact-phone-error {
  display: block;
  margin-top: 6px;
  color: var(--status-alarm-color);
  font-size: 12px;
  line-height: 1.5;
}

.form-label {
  font-size: 14px;
  color: #333;
  margin-bottom: 8px;
  display: block;
}

.modal-footer {
  padding: 12px 20px;
  border-top: 1px solid #eee;
  display: flex;
  flex-direction: row;
}

.modal-btn.cancel {
  margin-right: 6px;
}

.modal-btn.confirm {
  margin-left: 6px;
}

.btn-press {
  opacity: 0.7;
}

.unbind-section {
  margin: 0 15px 20px;
}

.unbind-btn {
  text-align: center;
  font-size: 14px;
  color: #f53f3f;
  padding: 12px;
  background: #fff;
  border-radius: 10px;
}

.unbind-btn:active {
  background: #fff1f0;
}
