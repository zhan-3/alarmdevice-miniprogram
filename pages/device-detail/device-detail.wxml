<view class="container">
  <!-- 加载态 -->
  <view wx:if="{{isLoading}}" class="loading-screen">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载设备信息...</text>
  </view>

  <view wx:elif="{{loadError}}" class="error-state">
    <text class="empty-text">设备信息加载失败</text>
    <text class="empty-hint">请检查网络连接或设备权限</text>
    <button class="retry-btn" bindtap="retryLoad">重新加载</button>
  </view>

  <block wx:else>
  <view class="map-section">
    <map
      wx:if="{{device.latitude && device.longitude}}"
      id="deviceMap"
      class="device-map"
      latitude="{{device.latitude}}"
      longitude="{{device.longitude}}"
      scale="15"
      markers="{{markers}}"
      show-location
    ></map>
    <view wx:else class="device-map map-empty">暂未设置安装位置</view>
  </view>

  <view class="device-overview">
    <view class="device-summary">
      <view class="device-name-row">
        <text class="device-name-text">{{device.name}}</text>
        <view class="alarm-badge {{device.status}}">
          <text wx:if="{{device.status === 'alarm'}}">报警中</text>
          <text wx:elif="{{device.status === 'normal'}}">正常</text>
          <text wx:elif="{{device.status === 'offline'}}">离线</text>
          <text wx:else>数据不可用</text>
        </view>
      </view>
      <view class="address-row">
        <app-icon name="map-pin" size="14" muted="{{true}}" />
        <text class="address-text">安装位置：{{device.address || '请设置安装位置'}}</text>
      </view>
    </view>

    <view class="quick-actions">
      <view class="quick-action nav-action" bindtap="startNavigation" aria-role="button" aria-label="导航到设备安装位置">
        <image class="action-img" src="/images/navigator.png" mode="aspectFit" />
        <text class="action-label">导航</text>
      </view>
      <view class="quick-action audio-action" bindtap="goAudioPage" aria-role="button" aria-label="查看报警录音">
        <image class="action-img" src="/images/voice.png" mode="aspectFit" />
        <text class="action-label">录音</text>
      </view>
      <view class="quick-action setting-action" bindtap="goSetting" aria-role="button" aria-label="打开设备设置">
        <image class="action-img" src="/images/setting.png" mode="aspectFit" />
        <text class="action-label">设置</text>
      </view>
    </view>
  </view>

  <white-card title="报警联系人" customClass="contact-card" showRightContent="true">
    <view slot="rightContent">
      <view class="add-btn {{savingContact || contactsRefreshing || contactRefreshError || deletingContactId ? 'btn-disabled' : ''}}" bindtap="showAddContact" aria-role="button" aria-label="添加其他紧急联系人">
        <app-icon name="plus" size="18" />
      </view>
    </view>

    <view class="contact-helper">你自己默认接收报警通知，以下为额外联系人</view>
    <view wx:if="{{contactRefreshError}}" class="contact-refresh-state">
      <text aria-role="alert">{{contactRefreshError}}</text>
      <button class="contact-retry" disabled="{{contactsRefreshing || savingContact}}" bindtap="retryContacts">{{contactsRefreshing ? '正在刷新…' : '重新加载联系人'}}</button>
    </view>
    <text wx:elif="{{contactsRefreshing}}" class="contact-helper">正在刷新联系人…</text>

    <view wx:for="{{device.contacts}}" wx:key="id" class="contact-item-wrap {{swipeId === item.id && swipeOffset < 0 ? 'swiped' : ''}}">
      <view
        class="contact-item"
        bindtouchstart="touchStart"
        bindtouchmove="touchMove"
        bindtouchend="touchEnd"
        data-id="{{item.id}}"
        style="transform: translateX({{swipeId === item.id ? swipeOffset : 0}}px)"
      >
        <view class="contact-info">
          <view class="contact-name">{{item.name}}</view>
          <view class="contact-phone">{{item.phone}}</view>
        </view>
      </view>
      <view class="delete-btn {{deletingContactId || savingContact || contactsRefreshing || contactRefreshError ? 'btn-disabled' : ''}}" data-id="{{item.id}}" bindtap="deleteContact">{{deletingContactId === item.id ? '删除中…' : '删除'}}</view>
    </view>

    <view wx:if="{{!contactsRefreshing && !contactRefreshError && (!device || !device.contacts || device.contacts.length === 0)}}" class="empty-state">
      <view class="empty-icon"><app-icon name="user-round-x" size="42" muted="{{true}}" label="暂无其他紧急联系人" /></view>
      <text class="empty-text">暂无其他紧急联系人</text>
      <text class="empty-hint">点击右上角「＋」添加联系人</text>
    </view>
  </white-card>

  <view class="unbind-section">
    <view class="unbind-btn" bindtap="confirmRemoveDevice">从本机移除设备</view>
  </view>
  </block>
</view>

<!-- 修改设备名称弹窗 -->
<view class="modal-mask" wx:if="{{showEditNameModal}}" bindtap="closeEditNameModal"></view>
<view class="modal-container" wx:if="{{showEditNameModal}}" catchtap>
  <view class="modal-header">
    <view class="modal-title">修改设备名称</view>
    <view class="modal-close" bindtap="closeEditNameModal" aria-label="关闭">
      <app-icon name="x-gray" size="20" />
    </view>
  </view>
  <view class="modal-body">
    <input 
      class="modal-input" 
      type="text" 
      placeholder="请输入设备名称" 
      bindinput="onNameInput"
      value="{{tempName}}"
      maxlength="20"
    />
  </view>
  <view class="modal-footer">
    <button class="modal-btn cancel" bindtap="closeEditNameModal" hover-class="btn-press">取消</button>
    <button class="modal-btn confirm {{savingName ? 'btn-disabled' : ''}}" disabled="{{savingName}}" bindtap="saveName" hover-class="btn-press">{{savingName ? '保存中…' : '保存'}}</button>
  </view>
</view>

<!-- 添加其他紧急联系人弹窗 -->
<view class="modal-mask" wx:if="{{showAddContactModal}}" bindtap="closeAddContactModal"></view>
<view class="modal-container" wx:if="{{showAddContactModal}}" catchtap>
  <view class="modal-header">
    <view class="modal-title">添加其他紧急联系人</view>
    <view class="modal-close" bindtap="closeAddContactModal" aria-label="关闭">
      <app-icon name="x-gray" size="20" />
    </view>
  </view>
  <view class="modal-body">
    <view class="form-item">
      <label class="form-label">联系人称呼（选填）</label>
      <input 
        class="modal-input" 
        type="text" 
        placeholder="选填，最多20个字符"
        bindinput="onContactNameInput"
        value="{{tempContactName}}"
        maxlength="20"
        disabled="{{savingContact}}"
      />
      <text class="contact-field-hint">用于未设置账号昵称的联系人，同设备关联用户可见。</text>
    </view>
    <view class="form-item">
      <label class="form-label">手机号</label>
      <input 
        class="modal-input" 
        type="number" 
        placeholder="请输入11位手机号" 
        bindinput="onContactPhoneInput"
        value="{{tempContactPhone}}"
        disabled="{{savingContact}}"
        maxlength="11"
      />
      <text wx:if="{{contactPhoneError}}" class="contact-phone-error" aria-role="alert">{{contactPhoneError}}</text>
    </view>
    <text wx:if="{{contactSaveError}}" class="contact-phone-error" aria-role="alert">{{contactSaveError}}</text>
  </view>
  <view class="modal-footer">
    <button class="modal-btn cancel" disabled="{{savingContact}}" bindtap="closeAddContactModal" hover-class="btn-press">取消</button>
    <button class="modal-btn confirm {{savingContact || contactPhoneError ? 'btn-disabled' : ''}}" disabled="{{savingContact || !!contactPhoneError}}" bindtap="saveContact" hover-class="btn-press">{{savingContact ? '添加中…' : '确认添加'}}</button>
  </view>
</view>