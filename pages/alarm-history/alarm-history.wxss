.history-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 20px 15px 32px;
  background: var(--bg-wash);
}

.history-header,
.history-item,
.history-item-topline,
.handling-summary,
.filter-trigger,
.filter-actions,
.date-row,
.handler-search {
  display: flex;
  align-items: center;
}

.history-header {
  justify-content: space-between;
  gap: 16px;
  margin: 0 2px 14px;
}

.history-title,
.history-subtitle,
.field-label,
.alarm-time {
  display: block;
}

.history-title {
  color: var(--text-main);
  font-size: 20px;
  font-weight: 650;
}

.history-subtitle {
  margin-top: 2px;
  color: var(--text-secondary);
  font-size: 12px;
}

.filter-trigger {
  justify-content: center;
  flex: 0 0 auto;
  gap: 5px;
  min-width: 72px;
  min-height: 44px;
  padding: 0 13px;
  box-sizing: border-box;
  border: 1rpx solid var(--border-color);
  border-radius: var(--radius-sm);
  background: #fff;
  color: var(--text-secondary);
  font-size: 13px;
  font-weight: 600;
}

.filter-trigger.active {
  border-color: var(--orange-border);
  background: var(--orange-light);
  color: var(--orange-dark);
}

.filter-panel,
.handler-panel,
.state-panel {
  border: 1rpx solid var(--border-color);
  border-radius: var(--radius-md);
  background: #fff;
}

.filter-panel {
  margin-bottom: 14px;
  padding: 17px;
}

.field-group + .field-group {
  margin-top: 15px;
}

.field-label {
  margin-bottom: 7px;
  color: #3c4651;
  font-size: 12px;
  font-weight: 600;
}

.text-input,
.picker-value,
.handler-search-input {
  min-height: 44px;
  box-sizing: border-box;
  border: 1rpx solid #d8dde2;
  border-radius: var(--radius-sm);
  background: #fff;
  color: var(--text-main);
  font-size: 14px;
}

.text-input,
.handler-search-input {
  padding: 0 13px;
}

.date-row {
  gap: 9px;
}

.date-picker {
  flex: 1;
  min-width: 0;
}

.picker-value {
  display: flex;
  align-items: center;
  padding: 0 12px;
}

.handler-value {
  justify-content: space-between;
}

.placeholder {
  color: #8a929a;
}

.date-separator {
  color: var(--text-secondary);
  font-size: 12px;
}

.date-clear-row {
  display: flex;
  justify-content: flex-end;
  gap: 18px;
  margin-top: 6px;
  color: var(--orange-dark);
  font-size: 11px;
}

.picker-arrow {
  color: #777;
  font-size: 21px;
}

.filter-actions {
  justify-content: flex-end;
  gap: 10px;
  margin-top: 18px;
  padding-top: 15px;
  border-top: 1rpx solid #edf0f2;
}

.primary-button,
.secondary-button {
  min-width: 92px;
  min-height: 44px;
  margin: 0;
  padding: 0 18px;
  border-radius: var(--radius-sm);
  font-size: 14px;
  line-height: 44px;
}

.primary-button {
  background: var(--orange-action);
  color: #fff;
}

.secondary-button {
  border: 1rpx solid #cfd5da;
  background: #fff;
  color: #3f4954;
}

.handler-panel {
  margin-bottom: 14px;
  padding: 12px;
}

.handler-search {
  gap: 9px;
  margin-bottom: 8px;
}

.handler-search-input {
  flex: 1;
  min-width: 0;
}

.search-action,
.close-action {
  min-height: 44px;
  line-height: 44px;
  color: var(--orange-dark);
  font-size: 13px;
  font-weight: 600;
}

.close-action {
  color: var(--text-secondary);
}

.handler-option {
  min-height: 44px;
  padding: 0 12px;
  border-top: 1rpx solid #edf0f2;
  color: var(--text-main);
  font-size: 14px;
  line-height: 44px;
}

.handler-option.selected {
  background: var(--orange-light);
  color: var(--orange-dark);
  font-weight: 600;
}

.handler-state {
  padding: 18px 12px 8px;
  color: var(--text-secondary);
  text-align: center;
  font-size: 12px;
}

.handler-state.error,
.retry-more {
  color: var(--orange-dark);
}

.history-loading {
  min-height: 52vh;
}

.state-panel {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 260px;
  justify-content: center;
  padding: 34px 24px;
  box-sizing: border-box;
  text-align: center;
}

.state-icon {
  margin-bottom: 12px;
}

.state-title {
  color: var(--text-main);
  font-size: 16px;
  font-weight: 600;
}

.state-hint {
  margin-top: 5px;
  color: var(--text-secondary);
  font-size: 13px;
}

.retry-button,
.empty-action {
  margin-top: 18px;
}

.history-item {
  gap: 12px;
  min-height: 120px;
  margin-bottom: 10px;
  padding: 17px 15px 17px 17px;
  box-sizing: border-box;
  border: 1rpx solid #d7e3da;
  border-radius: var(--radius-md);
  background: #fff;
}

.history-item-main,
.device-identity {
  flex: 1;
  min-width: 0;
}

.history-item-topline {
  justify-content: space-between;
  gap: 12px;
}

.device-name,
.device-sn {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.device-name {
  color: var(--text-main);
  font-size: 15px;
  font-weight: 600;
}

.device-sn {
  margin-top: 2px;
  color: var(--text-secondary);
  font-size: 12px;
}

.handled-badge {
  flex: 0 0 auto;
  padding: 3px 8px;
  border-radius: 7px;
  background: var(--status-normal-bg);
  color: var(--status-normal-color);
  font-size: 12px;
}

.alarm-time {
  margin-top: 7px;
  color: var(--text-secondary);
  font-size: 13px;
}

.handling-summary {
  flex-wrap: wrap;
  gap: 5px;
  margin-top: 11px;
  color: #4f5a65;
  font-size: 12px;
}

.summary-divider {
  color: #a0a6ac;
}

.row-arrow {
  flex: 0 0 auto;
  width: 17px;
  height: 17px;
}

.tap-active {
  opacity: 0.72;
}

.list-footer {
  padding: 10px 14px 5px;
  color: #7b838b;
  text-align: center;
  font-size: 12px;
}

.end-text {
  color: #999fa5;
}
