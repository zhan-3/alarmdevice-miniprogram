<view class="container">
  <!-- 加载态 -->
  <view wx:if="{{pageLoading}}" class="loading-screen">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <view wx:elif="{{loadError}}" class="error-state">
    <text class="empty-text">设备数据加载失败</text>
    <text class="empty-hint">请检查网络连接后重试</text>
    <button class="retry-btn" bindtap="retryLoad">重新加载</button>
  </view>

  <block wx:else>
  <view class="device-toolbar">
    <view>
      <text class="device-total">{{devices.length}} 台设备</text>
      <text class="device-total-hint">已绑定到当前账户</text>
    </view>
    <button class="add-device-button" bindtap="goBindDevice">
      <app-icon name="plus" size="17" />
      <text>添加设备</text>
    </button>
  </view>

  <view wx:if="{{isLogin && !hasPhone}}" class="phone-banner" bindtap="goBindPhone" aria-role="button" aria-label="前往绑定手机号">
    <app-icon name="smartphone" size="20" label="绑定手机号" />
    <view class="phone-banner-text">
      <text>请先绑定手机号以确保报警服务正常使用</text>
      <text class="phone-banner-link">去设置 ›</text>
    </view>
  </view>

  <white-card customClass="device-card">
    <view wx:for="{{devices}}" wx:key="id" class="device-item" bindtap="goDeviceDetail" data-id="{{item.id}}" aria-role="button" aria-label="查看设备 {{item.name}}">
      <view class="device-info">
        <view class="device-name">{{item.name}}</view>
        <view class="device-sn">SN {{item.sn}}</view>
      </view>
      <view class="device-status-group">
        <view class="device-status {{item.status}}">{{item.statusText}}</view>
        <app-icon name="chevron-right-gray" size="18" />
      </view>
    </view>

    <view wx:if="{{!devices || devices.length === 0}}" class="empty-state">
      <view class="empty-icon"><app-icon name="inbox" size="44" muted="{{true}}" label="暂无设备" /></view>
      <text class="empty-text">暂未绑定设备</text>
      <text class="empty-hint">点击上方「添加设备」开始绑定</text>
    </view>
  </white-card>
  </block>
</view>
