.container {
  padding: 20px 15px 15px;
  background: var(--bg-wash);
  min-height: 100vh;
}

.device-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin: 4px 2px 16px;
}

.device-total,
.device-total-hint {
  display: block;
}

.device-total {
  color: var(--text-main);
  font-size: 20px;
  font-weight: 600;
  line-height: 1.3;
}

.device-total-hint {
  margin-top: 3px;
  color: var(--text-secondary);
  font-size: 13px;
}

.add-device-button {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  flex-shrink: 0;
  min-height: 44px;
  margin: 0;
  padding: 0 16px;
  border: 1px solid var(--orange-border);
  border-radius: 12px;
  background: var(--orange-light);
  color: var(--orange-dark);
  font-size: 13px;
  font-weight: 600;
  line-height: 1;
}

.add-device-button::after {
  border: 0;
}

.device-card { margin-bottom: 15px; }

.device-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 72px;
  padding: 13px 0;
  border-bottom: 1px solid #f0eeeb;
  box-sizing: border-box;
}

.device-item:last-child { border-bottom: none; }

.device-item:active {
  background: #F7F8F9;
}

.device-info { 
  flex: 1;
  min-width: 0;
}

.device-name,
.device-sn {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.device-name {
  color: var(--text-main);
  font-size: 15px;
  font-weight: 600;
}

.device-sn {
  margin-top: 3px;
  color: var(--text-secondary);
  font-size: 12px;
}

.device-status-group {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-shrink: 0;
}

.device-status {
  padding: 4px 10px;
  border-radius: 8px;
  font-size: 12px;
  font-weight: 600;
}

.device-status.alarm {
  background: var(--status-alarm-bg);
  color: var(--status-alarm-color);
}

.device-status.normal {
  background: var(--status-normal-bg);
  color: var(--status-normal-color);
}

.device-status.offline,
.device-status.unknown {
  background: var(--status-offline-bg);
  color: var(--status-offline-color);
}

.device-arrow {
  font-size: 20px;
  color: #ccc;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30px 20px;
}

.empty-icon {
  margin-bottom: 12px;
}

.empty-text {
  font-size: 15px;
  color: #999;
  margin-bottom: 6px;
}

.empty-hint {
  font-size: 12px;
  color: #bbb;
}

.phone-banner {
  background: #FFF7E8;
  border: 1px solid #EACB91;
  border-radius: var(--radius-md);
  padding: 13px 16px;
  margin-bottom: 16px;
  display: flex;
  align-items: center;
  gap: 10px;
}

.phone-banner-icon {
  font-size: 20px;
  flex-shrink: 0;
}

.phone-banner-text {
  flex: 1;
  font-size: 13px;
  color: #8d6e00;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.phone-banner-link {
  font-weight: 600;
  color: var(--orange-dark);
  flex-shrink: 0;
}
