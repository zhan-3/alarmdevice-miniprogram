<view class="login-page">
  <view class="login-header">
    <view class="logo-icon">
      <app-icon name="bell-dark" size="48" label="报警系统" />
    </view>
    <text class="title">紧急报警系统</text>
    <text class="subtitle" wx:if="{{step === 1}}">微信登录后绑定手机号即可使用</text>
    <text class="subtitle" wx:elif="{{step === 2}}">首次使用需要验证手机号</text>
  </view>

  <view class="login-content">
    <block wx:if="{{step === 1}}">
      <button class="login-btn" bindtap="doLogin" disabled="{{loading || privacyAuthorizing}}">
        <text class="btn-text">{{privacyAuthorizing ? '等待隐私授权…' : loading ? '登录中...' : '微信登录'}}</text>
      </button>
    </block>

    <block wx:elif="{{step === 2}}">
      <view class="phone-section">
        <input
          class="phone-input {{phoneError ? 'input-error' : ''}}"
          type="number"
          maxlength="11"
          placeholder="请输入手机号"
          value="{{phone}}"
          disabled="{{confirmingPhone}}"
          bindinput="onPhoneInput"
        />
        <text wx:if="{{phoneError}}" class="input-error-tip">手机号格式不正确（1开头，11位）</text>
        <view class="code-row">
          <input
            class="code-input"
            type="number"
            maxlength="6"
            placeholder="6位验证码"
            value="{{verificationCode}}"
            disabled="{{confirmingPhone}}"
            bindinput="onVerificationCodeInput"
          />
          <button class="code-button" bindtap="sendVerificationCode" disabled="{{loading || privacyAuthorizing || sendingCode || confirmingPhone || countdown > 0}}">
            {{countdown > 0 ? countdown + '秒' : sendingCode ? '发送中...' : '获取验证码'}}
          </button>
        </view>
        <view class="usage-notice">
          <text class="usage-notice-title">使用须知</text>
          <text class="usage-notice-copy">报警标记为“已处理”仅表示人工确认，不代表设备当前已经恢复正常。</text>
        </view>
        <button class="login-btn" bindtap="confirmPhone" disabled="{{loading || privacyAuthorizing || confirmingPhone || sendingCode || phoneError}}">
          <text class="btn-text">{{privacyAuthorizing ? '等待隐私授权…' : loading || confirmingPhone ? '验证中...' : '验证并进入'}}</text>
        </button>
      </view>
    </block>

    <view class="privacy-agreement">
      <text class="privacy-hint">首次使用需完成微信隐私授权</text>
      <button class="privacy-link" bindtap="openPrivacyPolicy">查看《用户隐私保护指引》</button>
    </view>
    <text wx:if="{{errMsg}}" class="error-tip">{{errMsg}}</text>
  </view>
</view>
