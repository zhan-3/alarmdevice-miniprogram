<view class="login-page">
  <view class="login-header">
    <view class="logo-icon">
      <app-icon name="bell-white" size="48" label="报警系统" />
    </view>
    <text class="title">紧急报警系统</text>
    <text class="subtitle" wx:if="{{step === 1}}">微信登录后绑定手机号即可使用</text>
    <text class="subtitle" wx:elif="{{step === 2}}">首次使用需要验证手机号</text>
  </view>

  <view class="login-content">
    <block wx:if="{{step === 1}}">
      <button class="login-btn" bindtap="doLogin" disabled="{{loading}}">
        <text class="btn-text">{{loading ? '登录中...' : '微信登录'}}</text>
      </button>
    </block>

    <block wx:elif="{{step === 2}}">
      <view class="phone-section">
        <input
          class="phone-input {{phoneError ? 'input-error' : ''}}"
          type="number"
          maxlength="11"
          placeholder="请输入手机号"
          value="{{phone}}"
          disabled="{{confirmingPhone}}"
          bindinput="onPhoneInput"
        />
        <text wx:if="{{phoneError}}" class="input-error-tip">手机号格式不正确（1开头，11位）</text>
        <view class="code-row">
          <input
            class="code-input"
            type="number"
            maxlength="6"
            placeholder="6位验证码"
            value="{{verificationCode}}"
            disabled="{{confirmingPhone}}"
            bindinput="onVerificationCodeInput"
          />
          <button class="code-button" bindtap="sendVerificationCode" disabled="{{sendingCode || countdown > 0}}">
            {{countdown > 0 ? countdown + '秒' : sendingCode ? '发送中...' : '获取验证码'}}
          </button>
        </view>
        <button class="login-btn" bindtap="confirmPhone" disabled="{{loading || confirmingPhone || phoneError}}">
          <text class="btn-text">{{loading || confirmingPhone ? '验证中...' : '验证并进入'}}</text>
        </button>
      </view>
    </block>

    <text wx:if="{{errMsg}}" class="error-tip">{{errMsg}}</text>
  </view>
</view>
