.audio-container {
  min-height: 100vh;
  background: var(--bg-wash);
}

/* 播放器区域 */
.player-section {
  padding: 15px;
}

.player-card {
  background: var(--surface);
  border: 1rpx solid var(--border-color);
  border-radius: var(--radius-md);
  padding: 20px;
}

.player-header {
  display: flex;
  align-items: center;
  margin-bottom: 16px;
}

.player-icon {
  font-size: 40px;
  margin-right: 12px;
}

.player-info {
  flex: 1;
  min-width: 0;
}

.player-title {
  font-size: 16px;
  font-weight: 600;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.player-meta {
  font-size: 12px;
  color: var(--text-secondary);
  margin-top: 4px;
}

.player-status {
  font-size: 12px;
  padding: 4px 10px;
  border-radius: 12px;
  flex-shrink: 0;
}

.player-status.emergency {
  background: var(--status-alarm-bg);
  color: var(--status-alarm-color);
}

.player-status.normal {
  background: var(--status-normal-bg);
  color: var(--status-normal-color);
}

/* 播放控制 */
.player-controls {
  display: flex;
  align-items: center;
  margin-bottom: 16px;
}

.time-current, .time-total {
  font-size: 12px;
  color: var(--text-secondary);
  width: 40px;
  flex-shrink: 0;
}

.time-total {
  text-align: right;
}

.progress-slider {
  flex: 1;
  margin: 0 8px;
}

/* 控制按钮 */
.control-buttons {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 30px;
  margin-bottom: 16px;
}

.control-btn {
  width: 44px;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.control-btn image {
  width: 24px;
  height: 24px;
}

.control-btn.play-btn {
  width: 56px;
  height: 56px;
  background: var(--orange-action);
  border-radius: 50%;
  padding: 0;
}

.control-btn.play-btn image {
  width: 28px;
  height: 28px;
}

/* 速度控制 */
.speed-bar {
  display: flex;
  align-items: center;
  justify-content: center;
}

.speed-label {
  font-size: 12px;
  color: var(--text-secondary);
  margin-right: 10px;
}

.speed-options {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}

.speed-opt {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 44px;
  min-height: 44px;
  box-sizing: border-box;
  font-size: 12px;
  padding: 0 10px;
  border-radius: var(--radius-sm);
  background: #f5f5f5;
  color: var(--text-secondary);
}

.speed-opt.active {
  background: var(--orange-action);
  color: #fff;
}

/* 列表区域 */
.list-section {
  padding: 0 15px 15px;
}

.list-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16px 0;
}

.list-title {
  font-size: 16px;
  font-weight: 600;
  color: #333;
}

.list-actions {
  display: flex;
  gap: 8px;
  align-items: center;
}

.sort-btn, .filter-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  padding: 6px 10px;
  border-radius: 12px;
  background: #fff;
  color: #666;
  line-height: 1.2;
  min-height: 44px;
  box-sizing: border-box;
  border: 1px solid #eee;
  gap: 5px;
}

.audio-list {
  background: #fff;
  border-radius: 12px;
  max-height: calc(100vh - 400px);
}

/* 录音项 */
.audio-item {
  display: flex;
  align-items: center;
  padding: 14px;
  border-bottom: 1px solid #f0f0f0;
  transition: background 0.2s;
}

.audio-item:last-child {
  border-bottom: none;
}

.audio-item:active {
  background: #fafafa;
}

.audio-item.active {
  background: #FFF8F0;
}

.audio-icon {
  width: 36px;
  height: 36px;
  margin-right: 12px;
  border-radius: 10px;
  background: #fff3e8;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.audio-content {
  flex: 1;
  min-width: 0;
}

.audio-name {
  font-size: 14px;
  font-weight: 500;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.audio-details {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  font-size: 12px;
  color: var(--text-secondary);
  margin-top: 4px;
}

.audio-dot {
  margin: 0 4px;
}

.audio-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6px;
  flex-shrink: 0;
  margin-left: 12px;
}

.audio-status {
  font-size: 12px;
  padding: 2px 6px;
  border-radius: 4px;
}

.audio-status.emergency {
  background: var(--status-alarm-bg);
  color: var(--status-alarm-color);
}

.audio-status.normal {
  background: var(--status-normal-bg);
  color: var(--status-normal-color);
}

.collect-icon {
  width: 44px;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.control-pressed,
.collect-icon:active {
  opacity: 0.7;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40px 20px;
}

.empty-icon {
  margin-bottom: 16px;
}

.empty-text {
  font-size: 16px;
  color: #333;
  font-weight: 500;
  margin-bottom: 8px;
}

.empty-desc {
  font-size: 13px;
  color: var(--text-secondary);
}

/* 操作菜单弹窗 */
.action-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.action-sheet {
  width: 100%;
  background: #fff;
  border-radius: 16px 16px 0 0;
  padding-bottom: env(safe-area-inset-bottom);
}

.action-title {
  font-size: 14px;
  color: var(--text-secondary);
  text-align: center;
  padding: 16px;
  border-bottom: 1px solid #f0f0f0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.action-list {
  padding: 8px 0;
}

.action-item {
  display: flex;
  align-items: center;
  padding: 14px 20px;
}

.action-item:active {
  background: #f5f5f5;
}

.action-item.delete .action-text {
  color: #ff4d4f;
}

.action-icon {
  width: 24px;
  margin-right: 12px;
  display: flex;
  justify-content: center;
}

.action-text {
  font-size: 16px;
  color: #333;
}

.action-cancel {
  text-align: center;
  padding: 14px;
  background: #f5f5f5;
  font-size: 16px;
  color: #666;
}

.action-cancel:active {
  background: #eee;
}
