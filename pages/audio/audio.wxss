.audio-container {
  min-height: 100vh;
  background: var(--bg-wash);
}

/* 播放器区域 */
.player-section {
  padding: 15px;
  background: linear-gradient(135deg, var(--orange-primary) 0%, var(--orange-highlight) 100%);
}

.player-card {
  background: #fff;
  border-radius: 16px;
  padding: 20px;
  box-shadow: 0 4px 20px rgba(201, 79, 0, 0.18);
}

.player-header {
  display: flex;
  align-items: center;
  margin-bottom: 16px;
}

.player-icon {
  font-size: 40px;
  margin-right: 12px;
}

.player-info {
  flex: 1;
  min-width: 0;
}

.player-title {
  font-size: 16px;
  font-weight: 600;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.player-meta {
  font-size: 12px;
  color: #999;
  margin-top: 4px;
}

.player-status {
  font-size: 11px;
  padding: 4px 10px;
  border-radius: 12px;
  flex-shrink: 0;
}

.player-status.emergency {
  background: var(--status-alarm-bg);
  color: var(--status-alarm-color);
}

.player-status.normal {
  background: #E8F5E9;
  color: #52c41a;
}

/* 音频时间轴波形 */
.waveform-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 7px;
  color: var(--text-secondary);
  font-size: 12px;
}

.waveform-state {
  color: var(--text-secondary);
  font-weight: 500;
}

.waveform-state.is-playing {
  color: var(--orange-dark);
}

.waveform-wrap {
  position: relative;
  display: flex;
  align-items: center;
  height: 64px;
  margin-bottom: 10px;
  padding: 8px 10px;
  box-sizing: border-box;
  overflow: hidden;
  border: 1px solid var(--border-color);
  border-radius: 10px;
  background: #F7F8F9;
}

.waveform-axis {
  position: absolute;
  right: 10px;
  left: 10px;
  top: 50%;
  height: 1rpx;
  background: #D9DDE1;
}

.waveform {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 2px;
  width: 100%;
  height: 100%;
}

.wave-bar {
  flex: 1;
  min-width: 0;
  border-radius: 2px;
  background: #C9CED4;
  transform-origin: center;
  transition: background-color 0.16s ease-out, opacity 0.16s ease-out;
}

.wave-bar.played {
  background: var(--orange-action);
}

.waveform-playhead {
  position: absolute;
  z-index: 2;
  top: 7px;
  bottom: 7px;
  width: 2px;
  background: var(--orange-primary);
  box-shadow: 2px 0 8px rgba(240, 90, 40, 0.2);
  transform: translateX(-1px);
  pointer-events: none;
}

.waveform-playhead-dot {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 7px;
  height: 7px;
  border: 2px solid #FFFFFF;
  border-radius: 50%;
  background: var(--orange-primary);
  box-shadow: 0 2px 6px rgba(150, 59, 22, 0.28);
  transform: translate(-50%, -50%);
}

.waveform-playhead.active .waveform-playhead-dot {
  animation: playheadPulse 1.2s ease-in-out infinite;
}

@keyframes playheadPulse {
  0%, 100% {
    box-shadow: 0 2px 6px rgba(150, 59, 22, 0.28);
  }
  50% {
    box-shadow: 0 2px 6px rgba(150, 59, 22, 0.28), 0 0 0 4px rgba(240, 90, 40, 0.12);
  }
}

/* 播放控制 */
.player-controls {
  display: flex;
  align-items: center;
  margin-bottom: 16px;
}

.time-current, .time-total {
  font-size: 12px;
  color: #999;
  width: 40px;
  flex-shrink: 0;
}

.time-total {
  text-align: right;
}

.progress-slider {
  flex: 1;
  margin: 0 8px;
}

/* 控制按钮 */
.control-buttons {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 30px;
  margin-bottom: 16px;
}

.control-btn {
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.control-btn image {
  width: 24px;
  height: 24px;
}

.control-btn.play-btn {
  width: 56px;
  height: 56px;
  background: var(--orange-action);
  border-radius: 50%;
  padding: 0;
}

.control-btn.play-btn image {
  width: 28px;
  height: 28px;
}

/* 速度控制 */
.speed-bar {
  display: flex;
  align-items: center;
  justify-content: center;
}

.speed-label {
  font-size: 12px;
  color: #999;
  margin-right: 10px;
}

.speed-options {
  display: flex;
  gap: 8px;
}

.speed-opt {
  font-size: 12px;
  padding: 4px 10px;
  border-radius: 12px;
  background: #f5f5f5;
  color: #666;
}

.speed-opt.active {
  background: var(--orange-action);
  color: #fff;
}

/* 列表区域 */
.list-section {
  padding: 0 15px 15px;
}

.list-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16px 0;
}

.list-title {
  font-size: 16px;
  font-weight: 600;
  color: #333;
}

.list-actions {
  display: flex;
  gap: 8px;
  align-items: center;
}

.sort-btn, .filter-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  padding: 6px 10px;
  border-radius: 12px;
  background: #fff;
  color: #666;
  line-height: 1.2;
  min-height: 28px;
  box-sizing: border-box;
  border: 1px solid #eee;
  gap: 5px;
}

.audio-list {
  background: #fff;
  border-radius: 12px;
  max-height: calc(100vh - 400px);
}

/* 录音项 */
.audio-item {
  display: flex;
  align-items: center;
  padding: 14px;
  border-bottom: 1px solid #f0f0f0;
  transition: background 0.2s;
}

.audio-item:last-child {
  border-bottom: none;
}

.audio-item:active {
  background: #fafafa;
}

.audio-item.active {
  background: #FFF8F0;
}

.audio-icon {
  width: 36px;
  height: 36px;
  margin-right: 12px;
  border-radius: 10px;
  background: #fff3e8;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.audio-content {
  flex: 1;
  min-width: 0;
}

.audio-name {
  font-size: 14px;
  font-weight: 500;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.audio-details {
  display: flex;
  align-items: center;
  font-size: 12px;
  color: #999;
  margin-top: 4px;
}

.audio-dot {
  margin: 0 4px;
}

.audio-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6px;
  flex-shrink: 0;
  margin-left: 12px;
}

.audio-status {
  font-size: 10px;
  padding: 2px 6px;
  border-radius: 4px;
}

.audio-status.emergency {
  background: var(--status-alarm-bg);
  color: var(--status-alarm-color);
}

.audio-status.normal {
  background: #E8F5E9;
  color: #52c41a;
}

.collect-icon {
  width: 28px;
  height: 28px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.collect-icon:active {
  transform: scale(0.92);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40px 20px;
}

.empty-icon {
  margin-bottom: 16px;
}

.empty-text {
  font-size: 16px;
  color: #333;
  font-weight: 500;
  margin-bottom: 8px;
}

.empty-desc {
  font-size: 13px;
  color: #999;
}

/* 操作菜单弹窗 */
.action-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.action-sheet {
  width: 100%;
  background: #fff;
  border-radius: 16px 16px 0 0;
  padding-bottom: env(safe-area-inset-bottom);
}

.action-title {
  font-size: 14px;
  color: #999;
  text-align: center;
  padding: 16px;
  border-bottom: 1px solid #f0f0f0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.action-list {
  padding: 8px 0;
}

.action-item {
  display: flex;
  align-items: center;
  padding: 14px 20px;
}

.action-item:active {
  background: #f5f5f5;
}

.action-item.delete .action-text {
  color: #ff4d4f;
}

.action-icon {
  width: 24px;
  margin-right: 12px;
  display: flex;
  justify-content: center;
}

.action-text {
  font-size: 16px;
  color: #333;
}

.action-cancel {
  text-align: center;
  padding: 14px;
  background: #f5f5f5;
  font-size: 16px;
  color: #666;
}

.action-cancel:active {
  background: #eee;
}
